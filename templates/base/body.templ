package base

import "app/templates/meta"
import "app/routes"

type BodyParams struct {
	Content templ.Component
	Aside   templ.Component
}

templ body(params BodyParams, links routes.Links) {
	<body>
		<div class="hidden" id={ RedirectID }></div>
		@header(links)
		@main(params.Content, params.Aside)
		@footer()
	</body>
}

templ header(links routes.Links) {
	<header>
		<strong>
			{ meta.AppTitle }
		</strong>
		<nav>
			<ul>
				<li><a href={ links.URL(routes.APIDocs) }>API</a></li>
			</ul>
		</nav>
	</header>
}

templ main(content, aside templ.Component) {
	<main>
		if aside != nil {
			<aside>
				@aside
			</aside>
		}
		<div class="content">
			@content
		</div>
	</main>
}

templ footer() {
	<footer>
		© { meta.Year } { meta.AppTitle }
	</footer>
}
