package base

import "app/routes"
import "app/templates"

templ BrowserSurface(links routes.Links, content templ.Component, message string) {
	<div id="browser-view" data-error={ message }>
		<p role="alert" data-htmz-error></p>
		@content
	</div>
	<script type="module" src={ templates.MainScriptURL(links) }></script>
}
