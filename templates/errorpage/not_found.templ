package errorpage

import (
	"app/templates/base"
	"app/templates/meta"
)

templ NotFound(message, rootPrefix string) {
	@base.Page(base.PageParams{
		Head: base.HeadParams{Title: meta.AppTitle, Subtitle: message, RootPrefix: rootPrefix},
		Body: base.BodyParams{Content: notFoundContent(message)},
	})
}

templ notFoundContent(message string) {
	<section>
		<h1>404</h1>
		<p>{ message }</p>
	</section>
}
