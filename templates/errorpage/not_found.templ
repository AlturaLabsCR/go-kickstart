package errorpage

import (
	"app/templates/base"
 "app/routes"
	"app/templates/meta"
)

templ NotFound(message string, links routes.Links) {
	@base.Page(base.PageParams{
 Links: links,
		Head: base.HeadParams{Title: meta.AppTitle, Subtitle: message},
		Body: base.BodyParams{Content: notFoundContent(message)},
	})
}

templ notFoundContent(message string) {
	<section>
		<h1>404</h1>
		<p>{ message }</p>
	</section>
}
