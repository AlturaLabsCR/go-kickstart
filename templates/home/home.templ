package home

import "strings"

type Session struct {
	ID                     string
	Device                 string
	Browser                string
	OS                     string
	Created, Used, Expires int64
	Current                bool
}

templ Home(action, home, next string, sessions []Session, language string, tr func(string) string) {
	<section>
		<h1>{ tr("web.home") }</h1>
		<section class="card">
			<header>
				<hgroup><h2>{ tr("web.sessions") }</h2></hgroup>
				<div>
					<button type="button" class="plain" data-htmz data-href={ home + "#browser-view" } aria-label={ tr("web.reload") } title={ tr("web.reload") }>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M3 12a9 9 0 0 1 15.36-6.36L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.36 6.36L3 16M3 21v-5h5"></path>
						</svg>
					</button>
					<button type="button" class="plain" commandfor="logout" command="show-modal" aria-label={ tr("web.logout") } title={ tr("web.logout") }>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
						</svg>
					</button>
				</div>
			</header>
			<table>
				<thead><tr><th>{ tr("web.device") }</th><th>{ tr("web.created") }</th><th>{ tr("web.used") }</th><th>{ tr("web.expires") }</th><th></th></tr></thead>
				<tbody>
					for _,session := range sessions {
						<tr>
							<td>
								<div style="display:flex;align-items:center;gap:calc(var(--space) / 2)">
									@device(session, tr)
								</div>
							</td>
							<td>@timestamp(language, session.Created, false)</td>
							<td>@timestamp(language, session.Used, true)</td>
							<td>@timestamp(language, session.Expires, false)</td>
							<td>
								<a href={ "#revoke-" + session.ID } data-dialog-open={ "revoke-" + session.ID } aria-haspopup="dialog" aria-controls={ "revoke-" + session.ID }>{ tr("web.logout") }</a>
								@confirmLogout("revoke-"+session.ID, action, "revoke", session.ID, strings.TrimSpace(session.OS+" "+session.Browser), session.Current, tr)
							</td>
						</tr>
					}
				</tbody>
			</table>
			if next!="" {
				<a href={ next } data-htmz>{ tr("web.next") }</a>
			}
		</section>
		@confirmLogout("logout", action, "logout", "", "", true, tr)
	</section>
}
