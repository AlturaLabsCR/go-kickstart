package browser

// Device icons come from Simple Icons (CC0 1.0):
// https://github.com/simple-icons/simple-icons

func browserIcon(name string) string {
	switch name {
	case "Chrome", "Headless Chrome":
		return "googlechrome"
	case "Firefox":
		return "firefox"
	case "Safari":
		return "safari"
	case "Edge":
		return "microsoftedge"
	case "Opera":
		return "opera"
	case "Internet Explorer":
		return "internetexplorer"
	}
	return ""
}

func osIcon(name string) string {
	switch name {
	case "Windows":
		return "windows"
	case "Mac OS X":
		return "apple"
	case "iOS":
		return "ios"
	case "Android":
		return "android"
	case "Linux", "Ubuntu", "Fedora", "Debian":
		return "linux"
	}
	return ""
}

templ deviceIcon(name, label string) {
	switch name {
	case "googlechrome":
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label={ label } focusable="false">
