package browser

import "time"
import "app/routes"

type Session struct {
	ID                     string
	Device                 string
	Browser                string
	OS                     string
	Created, Used, Expires int64
	Current                bool
}

func stamp(value int64) string {
	if value == 0 {
		return "—"
	}
	return time.Unix(value, 0).UTC().Format(time.RFC3339)
}

templ Login(action, email, message string, verify, refresh bool, tr func(string) string) {
	<section>
		<form method="post" action={ action + "#browser-view" } data-htmz>
			<h1>{ tr("web.login") }</h1>
			if verify {
				<input type="hidden" name="action" value="verify"/>
				<label for="login-email">{ tr("web.email") }</label>
				<input id="login-email" type="email" name="email" value={ email } readonly required/>
				<label for="login-otp">{ tr("web.code") }</label>
				<input id="login-otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus/>
				<footer>
					<a class="button outline" href={ action }>{ tr("web.restart") }</a>
					<button type="submit">{ tr("web.verify") }</button>
				</footer>
			} else {
				<input type="hidden" name="action" value="login"/>
				<label for="login-email">{ tr("web.email") }</label>
				<input id="login-email" type="email" name="email" value={ email } autocomplete="email" required/>
				if message!="" {
					<p role="alert">{ message }</p>
				}
				<footer>
					<button type="submit">{ tr("web.send") }</button>
				</footer>
			}
		</form>
		if refresh {
			<form method="post" action={ action + "#browser-view" } data-htmz><button name="action" value="refresh">{ tr("web.continue") }</button></form>
		}
	</section>
}

templ Home(action, home, next string, sessions []Session, tr func(string) string) {
	<section>
		<h1>{ tr("web.home") }</h1>
		<article class="card">
			<header>
				<hgroup><h2>{ tr("web.sessions") }</h2></hgroup>
				<div>
					<button type="button" class="plain" data-htmz data-href={ home + "#browser-view" } aria-label={ tr("web.reload") } title={ tr("web.reload") }>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M3 12a9 9 0 0 1 15.36-6.36L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.36 6.36L3 16M3 21v-5h5"></path>
						</svg>
					</button>
					<button type="button" class="plain" commandfor="logout" command="show-modal" aria-label={ tr("web.logout") } title={ tr("web.logout") }>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
						</svg>
					</button>
				</div>
			</header>
			<table>
				<thead><tr><th>{ tr("web.device") }</th><th>{ tr("web.created") }</th><th>{ tr("web.used") }</th><th>{ tr("web.expires") }</th><th>{ tr("web.logout") }</th></tr></thead>
				<tbody>
					for _,session := range sessions {
						<tr>
							<td>
								<div style="display:flex;align-items:center;gap:calc(var(--space) / 2)">
									@device(session, tr)
								</div>
							</td>
							<td>{ stamp(session.Created) }</td>
							<td>{ stamp(session.Used) }</td>
							<td>{ stamp(session.Expires) }</td>
							<td>
								<a href={ "#revoke-" + session.ID } data-dialog-open={ "revoke-" + session.ID } aria-haspopup="dialog" aria-controls={ "revoke-" + session.ID }>{ tr("web.logout") }</a>
								@confirmLogout("revoke-"+session.ID, action, "revoke", session.ID, session.Device, session.Current, tr)
							</td>
						</tr>
					}
				</tbody>
			</table>
			if next!="" {
				<a href={ next } data-htmz>{ tr("web.next") }</a>
			}
		</article>
		@confirmLogout("logout", action, "logout", "", "", true, tr)
	</section>
}

templ device(session Session, tr func(string) string) {
	{{ browserName, osName := browserIcon(session.Browser), osIcon(session.OS) }}
	if osName != "" {
		@deviceIcon(osName, session.OS)
	}
	if browserName != "" {
		@deviceIcon(browserName, session.Browser)
	}
	if browserName == "" && osName == "" {
		{ session.Device }
	}
	if session.Current {
		<strong>({ tr("web.current") })</strong>
	}
}

templ confirmLogout(id, action, operation, sessionID, device string, current bool, tr func(string) string) {
	<dialog id={ id } aria-labelledby={ id + "-title" } aria-describedby={ id + "-description" }>
		<hgroup>
			<h2 id={ id + "-title" }>{ tr("web.confirm_logout") }</h2>
			<button type="button" commandfor={ id } command="close" aria-label={ tr("web.close") }>×</button>
			<p id={ id + "-description" }>
				if current {
					{ tr("web.logout_current") }
				} else {
					{ tr("web.logout_device") + " " }
					if device!="" {
						{ device }
					} else {
						{ tr("web.unknown_device") }
					}
				}
			</p>
		</hgroup>
		<p role="alert" data-htmz-error></p>
		<form id={ id + "-form" } hidden method="post" action={ action + "#browser-view" } data-htmz>
			<input type="hidden" name="action" value={ operation }/>
			<input type="hidden" name="session_id" value={ sessionID }/>
		</form>
		<footer>
			<button type="button" class="outline" commandfor={ id } command="close" autofocus>{ tr("web.cancel") }</button>
			<button type="submit" form={ id + "-form" }>{ tr("web.logout") }</button>
		</footer>
	</dialog>
}

templ Surface(links routes.Links, content templ.Component, message string) {
	<div id="browser-view" data-error={ message }>
		<p role="alert" data-htmz-error></p>
		@content
	</div>
	<script type="module" src={ links.StaticURL("js/browser.js") }></script>
}
