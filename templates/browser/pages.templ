package browser

import "time"
import "app/routes"

type Session struct {
	ID                     string
	Device                 string
	Created, Used, Expires int64
	Current                bool
}

func stamp(value int64) string {
	if value == 0 {
		return "—"
	}
	return time.Unix(value, 0).UTC().Format(time.RFC3339)
}

templ Login(action, email, message string, verify, refresh bool, tr func(string) string) {
	<section>
		<h1>{ tr("web.login") }</h1>
		if message!="" {
			<p role="alert">{ message }</p>
		}
		<form method="post" action={ action + "#browser-view" } data-htmz>
			if verify {
				<input type="hidden" name="action" value="verify"/>
				<label for="login-email">{ tr("web.email") }</label>
				<input id="login-email" type="email" name="email" value={ email } readonly required/>
				<label for="login-otp">{ tr("web.code") }</label>
				<input id="login-otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus/>
				<button type="submit">{ tr("web.verify") }</button>
			} else {
				<input type="hidden" name="action" value="login"/>
				<label for="login-email">{ tr("web.email") }</label>
				<input id="login-email" type="email" name="email" value={ email } autocomplete="email" required/>
				<button type="submit">{ tr("web.send") }</button>
			}
		</form>
		if refresh {
			<form method="post" action={ action + "#browser-view" } data-htmz><button name="action" value="refresh">{ tr("web.continue") }</button></form>
		}
		if verify {
			<a href={ action }>{ tr("web.restart") }</a>
		}
	</section>
}

templ Home(action, home, next string, sessions []Session, tr func(string) string) {
	<section>
		<h1>{ tr("web.home") }</h1>
		<h2>{ tr("web.sessions") }</h2>
		<button type="button" data-htmz data-href={ home + "#browser-view" }>{ tr("web.reload") }</button>
		<table>
			<thead><tr><th>{ tr("web.device") }</th><th>{ tr("web.created") }</th><th>{ tr("web.used") }</th><th>{ tr("web.expires") }</th><th>{ tr("web.logout") }</th></tr></thead>
			<tbody>
				for _,session := range sessions {
					<tr>
						<td>
							{ session.Device }
							if session.Current {
								<strong>({ tr("web.current") })</strong>
							}
						</td>
						<td>{ stamp(session.Created) }</td>
						<td>{ stamp(session.Used) }</td>
						<td>{ stamp(session.Expires) }</td>
						<td>
							<button type="button" class="plain" commandfor={ "revoke-" + session.ID } command="show-modal">{ tr("web.logout") }</button>
							@confirmLogout("revoke-"+session.ID, action, "revoke", session.ID, tr)
						</td>
					</tr>
				}
			</tbody>
		</table>
		if next!="" {
			<a href={ next } data-htmz>{ tr("web.next") }</a>
		}
		<button type="button" commandfor="logout" command="show-modal">{ tr("web.logout") }</button>
		@confirmLogout("logout", action, "logout", "", tr)
	</section>
}

templ confirmLogout(id, action, operation, sessionID string, tr func(string) string) {
	<dialog id={ id } aria-labelledby={ id + "-title" }>
		<header>
			<h2 id={ id + "-title" }>{ tr("web.confirm_logout") }</h2>
			<button type="button" commandfor={ id } command="close" aria-label={ tr("web.close") }>×</button>
		</header>
		<p role="alert" data-htmz-error></p>
		<form id={ id + "-form" } hidden method="post" action={ action + "#browser-view" } data-htmz>
			<input type="hidden" name="action" value={ operation }/>
			<input type="hidden" name="session_id" value={ sessionID }/>
		</form>
		<footer>
			<button type="button" class="plain" commandfor={ id } command="close" autofocus>{ tr("web.cancel") }</button>
			<button type="submit" form={ id + "-form" }>{ tr("web.logout") }</button>
		</footer>
	</dialog>
}

templ Surface(links routes.Links, content templ.Component, message string) {
	<div id="browser-view" data-error={ message }>
		<p role="alert" data-htmz-error></p>
		@content
	</div>
	<script type="module" src={ links.StaticURL("js/browser.js") }></script>
}
